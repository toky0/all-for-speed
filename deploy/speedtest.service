[Unit]
Description=all-for-speed speed test server
Documentation=https://git.marwan.ma/MARWAN/all-for-speed
After=network-online.target
Wants=network-online.target

[Service]
User=speedtest
Group=speedtest
EnvironmentFile=/etc/speedtest/speedtest.env
ExecStart=/usr/local/bin/speedtest -domain ${DOMAIN} -name ${NAME} -location ${LOCATION} -max-down ${MAX_DOWN} -max-up ${MAX_UP} $EXTRA_ARGS
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

# Bind 80/443 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Sandboxing. If the service fails with status=226/NAMESPACE in the container,
# enable "nesting" on the CT, or comment out the Protect*/Private* lines.
ProtectSystem=strict
ReadOnlyPaths=/etc/speedtest /var/lib/speedtest
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
